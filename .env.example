# Firebase - Notificashub (studio-3864746689-59018)
# Copia este archivo a .env.local y completa los valores

# Firebase Client (web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (servidor) - ruta al JSON de clave privada
# Por defecto usa: studio-3864746689-59018-firebase-adminsdk-fbsvc-5cdc673866.json
GOOGLE_APPLICATION_CREDENTIALS=

# Dashboard WhatsApp - contraseña para acceder al panel de mensajes
DASHBOARD_PASSWORD=

# WhatsApp Cloud API (Meta) - Router multi-tenant
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Alias aceptado por secrets:push si no usás la línea de arriba:
# WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=notificas_webhook_2026

# HeartLink - reenvío de mensajes entrantes (fallback si no en Firestore)
HEARTLINK_URL=https://heartlink--heartlink-f4ftq.us-central1.hosted.app
INTERNAL_SECRET=heartlink_internal_2026

# Opcional: si el número NO está en user_memberships, enrutar a este tenant (mismo id que tenants/{id})
# DEFAULT_INBOUND_TENANT_ID=planesdeahorro

# Contabilidad — sincronizar cobros desde la cuenta Mercado Pago de Notificas (token de la app en developers)
# MERCADOPAGO_ACCESS_TOKEN=
# Cuenta corriente bancaria única (extracto PDF → cobros/pagos). Si el PDF no trae número, se usa este valor.
# ACCOUNTING_BANK_ACCOUNT_NUMBER=385209425144719

# Firestore proyecto Notificas (webhook mail / whatsapp_ids) — también los sube secrets:push
# NOTIFICAS_FIREBASE_PROJECT_ID=
# NOTIFICAS_FIREBASE_CLIENT_EMAIL=
# NOTIFICAS_FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# URL pública del Hub (si la usás en HeartLink / tenants)
# NOTIFICASHUB_URL=https://tu-backend.hosted.app

# Google AI (Gemini) — facturas/pagos/extracto bancario PDF con IA (pdf-ingest, bank-ingest, verify-ai)
# Clave: https://aistudio.google.com/apikey (no commitear; solo .env.local o secreto en App Hosting)
GOOGLE_AI_API_KEY=
# Modelos opcionales (solo IDs Gemini; por defecto gemini-2.5-flash — evitá gemini-2.0-flash en cuentas nuevas)
# ACCOUNTING_PDF_AI_MODEL=gemini-2.5-flash
# BILLING_VERIFY_AI_MODEL=gemini-2.5-flash
#
# --- Firebase App Hosting: subir secretos desde .env.local ---
# Requiere `firebase login` y Node. Usa npx firebase-tools.
#   npm run secrets:push:dry   # solo lista qué subiría
#   npm run secrets:push       # sube valores y grantaccess al backend notificashub
# Opcional: APPHOSTING_PROJECT_ID=... APPHOSTING_BACKEND_ID=... npm run secrets:push

# Facturación recurrente (Resend) — envío de mail al emitir desde el panel
# RESEND_API_KEY=
# BILLING_EMAIL_FROM="Notificas SRL <facturas@tudominio.com>"
# Punto de venta por defecto (5 dígitos, ej. AFIP)
# BILLING_DEFAULT_PUNTO_VENTA=00002

# --- Recordatorios por mail (vencimientos Libro IVA orientativo / NotificasHub) ---
# Destino (obligatorio para enviar)
# TAX_REMINDER_TO=abengolea1@gmail.com
# CUIT completo (recomendado) o solo último dígito:
# TAX_REMINDER_CUIT=30-XXXXXXXX-X
# TAX_REMINDER_CUIT_DIGIT=3
# Secreto para disparar el cron (Authorization: Bearer … o header x-cron-secret)
# CRON_SECRET=genera_un_valor_largo_aleatorio
# URL pública de la app (link en el mail a /admin/contabilidad)
# APP_PUBLIC_BASE_URL=https://tu-dominio.app
#
# Mail: Resend (si ya usás facturación) O SMTP (ej. Gmail con contraseña de aplicación)
# RESEND_API_KEY=
# RESEND_FROM="Notificas SRL <avisos@tudominio.com>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
#
# Ventana y anti-spam (opcional)
# TAX_REMINDER_DIAS_ANTES=21
# TAX_REMINDER_DIAS_ATRAS_MAX_ABSOLUTO=120
# TAX_REMINDER_COOLDOWN_DAYS=7
# TAX_REMINDER_MONTHS_BACK=18
#
# Programá un job diario que llame:
#   GET /api/cron/tax-reminders
#   Header: Authorization: Bearer ${CRON_SECRET}
# (Vercel Cron, Cloud Scheduler, GitHub Actions, etc.)

# ========== AFIP — Notificas SRL (emisión automática con CAE) ==========
# Quien factura en este producto es siempre Notificas SRL: el certificado y AFIP_CUIT deben ser de esa sociedad
# (la autorizada en ARCA para WSFE). Los clientes del panel son receptores (SEAM, etc.), no sustituyen al emisor.
#
# AFIP_CUIT=33717298689
# AFIP_PRODUCTION=false
# Punto de venta de Notificas en ARCA (si el panel deja PV vacío, se usa este)
# AFIP_PTO_VTA=2
# Opcional: forzar siempre A/B/C para todos los clientes (normalmente no hace falta: usa el tipo guardado por cliente)
# AFIP_CBTE_TIPO=1
#
# Certificado + clave privada de Notificas SRL.
# En App Hosting usá secrets PEM; en local podés usar rutas absolutas.
# AFIP_CERT_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# AFIP_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# AFIP_CHAIN_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# AFIP_CERT_PATH=C:/secure/afip/homo/certificado_homo.crt
# AFIP_KEY_PATH=C:/secure/afip/homo/privada_homo.key
# AFIP_CHAIN_PATH=C:/secure/afip/homo/chain_nuevo.pem
# Relay Afip SDK (opcional). Si NO definís token, el ping y el futuro CAE nativo usan WSAA+WSFE directo con OpenSSL.
# Si el token lleva # o caracteres raros, usá comillas: AFIP_ACCESS_TOKEN="tok…"
# AFIP_ACCESS_TOKEN=
#
# OpenSSL: WSAA firma el TRA con `openssl cms`. En Windows, si no está en PATH, se busca en Git / OpenSSL-Win64.
# Si falla, definí la ruta explícita:
# OPENSSL_PATH=C:/Program Files/OpenSSL-Win64/bin/openssl.exe
#
# TLS cliente hacia servidores AFIP (OpenSSL 3 / Node): si ves ERR_SSL_DH_KEY_TOO_SMALL, el default ya usa SECLEVEL=1.
# Solo si aún falla: AFIP_TLS_SECLEVEL=0
#
# Datos extra en PDF o pantallas (si no, se usan los mismos textos que BILLING_EMISOR en código)
# AFIP_RAZON_SOCIAL=NOTIFICAS S. R. L.
# AFIP_DOMICILIO=Colón 12 Piso 1 — San Nicolás, Buenos Aires
# AFIP_TELEFONO=
# AFIP_EMAIL=
# AFIP_ING_BRUTOS=33717298689
# AFIP_INICIO_ACTIVIDADES=01/05/2022
#
# Producción ARCA (cuando toque, certificados de prod)
# AFIP_PRODUCTION=true
# AFIP_CERT_PATH=C:/secure/afip/prod/certificado.crt
# AFIP_KEY_PATH=C:/secure/afip/prod/privada.key
#
# Solo si en el futuro este backend atiende más de un “contexto” y querés validar el tenant en CAE:
# AFIP_EMIT_SCHOOL_ID=
# AFIP_WORK_DIR=C:/secure/afip/cache
#
# Integración servidor a servidor desde la app Notificas.
# La misma clave debe existir en `notificas` como NOTIFICAS_BILLING_SHARED_SECRET.
# NOTIFICAS_BILLING_SHARED_SECRET=
#
# npm run afip:folder-scan — carpeta con .crt/.pem/.cer/.key (default Windows: C:/secure/afip)
# AFIP_SCAN_ROOT=C:/secure/afip
